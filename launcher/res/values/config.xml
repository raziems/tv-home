<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher settings. Edit, then run launcher/build-and-install.sh (macOS) or
  launcher/build-windows.sh (Windows, Git Bash).
  Package names: adb shell cmd package query-activities -a android.intent.action.MAIN -c android.intent.category.LEANBACK_LAUNCHER
-->
<resources>
    <!-- Dock apps, left to right. Apps that aren't installed are skipped. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.tm.unifitv.tv</item>
        <item>com.wbd.stream</item>
        <item>com.spotify.tv.android</item>
        <item>com.apple.atve.sony.appletv</item>
    </string-array>

    <!-- Never shown as tiles: system helpers, and the Live TV app (it's in the Inputs menu). -->
    <string-array name="hidden_apps">
        <item>com.android.tv</item>
        <item>com.sony.dtv.tvx</item>
        <item>com.android.tv.settings</item>
        <item>com.sony.dtv.timers</item>
        <item>com.sony.dtv.ecodashboard</item>
        <item>com.sony.dtv.smarthelp</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, listed last in the Inputs menu: the first one installed is
         used, so one config serves several TVs. Sony Realtek sets (VU2, VU3) use Google's Live
         Channels, com.android.tv; Sony MediaTek sets (VH2 / X80J) use Sony's com.sony.dtv.tvx. -->
    <string-array name="live_tv_packages">
        <item>com.sony.dtv.tvx</item>
        <item>com.android.tv</item>
    </string-array>

    <!-- The manufacturer's own source picker, used if switching to an input directly fails.
         Same rule: the first one installed. -->
    <string-array name="input_picker_packages">
        <item>com.sony.dtv.tvx</item>
        <item>com.android.tv</item>
    </string-array>

    <!-- Glow colour per app, "package=#RRGGBB". Apps not listed get a colour sampled from their banner. -->
    <string-array name="app_colors">
        <item>com.netflix.ninja=#F5273C</item>
        <item>com.google.android.youtube.tv=#F764F7</item>
    </string-array>

    <!-- The remote's app buttons, "KEYCODE_NAME=package" (or a numeric key code). Find a button's
         key code with: adb shell dumpsys activity broadcasts history | grep keyCode   after pressing it.
         Sony BRAVIA Bluetooth remote: Netflix = KEYCODE_BUTTON_4, YouTube = KEYCODE_BUTTON_14. -->
    <string-array name="hotkeys">
        <item>KEYCODE_BUTTON_4=com.netflix.ninja</item>
        <item>KEYCODE_BUTTON_14=com.google.android.youtube.tv</item>
    </string-array>

    <!-- Tiles per row in the grid. -->
    <integer name="columns">5</integer>
</resources>
